# ==============================================================================
# AURAMATCH AI — PRODUCTION-READY AGENTIC DATING PLATFORM CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Admin Security
# ------------------------------------------------------------------------------
# Deployment environment: "development", "staging", or "production"
ENVIRONMENT=production

# Admin API Key protecting destructive and administrative operations
# (e.g. POST /api/v1/runs, DELETE /api/v1/participants/{id}, POST /api/v1/admin/seed-demo)
ADMIN_API_KEY=dev-admin-secret-change-in-prod

# Allowed CORS origins (JSON array or comma-separated string)
BACKEND_CORS_ORIGINS=["http://localhost:3000","https://auramatch.vercel.app"]

# ------------------------------------------------------------------------------
# 2. LLM Provider Configuration
# ------------------------------------------------------------------------------
# Options: "gemini" (production live LLM) or "offline_mock" (zero-credential offline test harness)
LLM_PROVIDER=gemini

# Google Gemini API key (required when LLM_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
MODEL_TIMEOUT_SECONDS=45

# ------------------------------------------------------------------------------
# 3. Database Persistence
# ------------------------------------------------------------------------------
# PostgreSQL for production or SQLite for portable local development:
#   SQLite:     sqlite:///./dating.db
#   PostgreSQL: postgresql://postgres:password@localhost:5432/auramatch
DATABASE_URL=sqlite:///./dating.db

# ------------------------------------------------------------------------------
# 4. Social Data Acquisition Adapters (Optional Credentials)
# ------------------------------------------------------------------------------
# Official LinkedIn OAuth Token (for authorized participant OAuth sync)
LINKEDIN_OAUTH_TOKEN=

# Official Instagram Graph API Access Token (for authorized Instagram sync)
INSTAGRAM_ACCESS_TOKEN=

# ------------------------------------------------------------------------------
# 5. Frontend Network Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
