# ==============================================================================
# AURAMATCH AI — PRODUCTION-READY AGENTIC DATING PLATFORM CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM Provider Configuration
# ------------------------------------------------------------------------------
# Google Gemini API key. If omitted, the platform automatically runs in deterministic
# test mode for 100% reproducible, offline evaluations.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
LLM_PROVIDER=gemini

# ------------------------------------------------------------------------------
# 2. Database Persistence
# ------------------------------------------------------------------------------
# Use SQLite for portable development or PostgreSQL for production deployments.
# Examples:
#   SQLite:     sqlite:///./dating.db
#   PostgreSQL: postgresql://postgres:password@localhost:5432/auramatch
DATABASE_URL=sqlite:///./dating.db

# ------------------------------------------------------------------------------
# 3. Social Data Acquisition Adapters (Optional Credentials)
# ------------------------------------------------------------------------------
# Official LinkedIn OAuth Token (if unauthenticated crawl is restricted)
LINKEDIN_OAUTH_TOKEN=

# Official Instagram Graph API Access Token
INSTAGRAM_ACCESS_TOKEN=

# ------------------------------------------------------------------------------
# 4. Frontend Network URL
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
