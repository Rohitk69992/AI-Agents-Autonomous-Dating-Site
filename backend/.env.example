# Backend environment settings
ENVIRONMENT=production
ADMIN_API_KEY=dev-admin-secret-change-in-prod
BACKEND_CORS_ORIGINS=["http://localhost:3000","https://auramatch.vercel.app"]

# LLM Provider: "groq", "gemini", or "offline_mock"
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Optional alternative: Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
MODEL_TIMEOUT_SECONDS=45

# Database URL
DATABASE_URL=sqlite:///./dating.db
# DATABASE_URL=postgresql://user:password@hostname:5432/dbname

# Optional Social OAuth Tokens
LINKEDIN_OAUTH_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
